<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>local.seaflow-transfer</string>
        <key>ProgramArguments</key>
        <array>
            <string>/Users/seaflow/bin/fda-wrapper</string>
			<string>/bin/bash</string>
            <string>/Users/seaflow/bin/seaflow-transfer.sh</string>
            <string>/Users/seaflow/seaflow-realtime.conf</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>StartInterval</key>
        <integer>300</integer>
        <key>ThrottleInterval</key>
        <integer>30</integer>
        <key>UserName</key>
        <string>seaflow</string>
        <key>GroupName</key>
        <string>staff</string>
        <key>StandardOutPath</key>
        <string>/Users/seaflow/log/seaflow-transfer.stdout</string>
        <key>StandardErrorPath</key>
        <string>/Users/seaflow/log/seaflow-transfer.stderr</string>
        <key>WorkingDirectory</key>
        <string>/Users/seaflow/</string>
    </dict>
</plist>
